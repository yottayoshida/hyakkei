{
  "name": "hyakkei-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm run build && pnpm -r run test",
    "test:e2e": "playwright test",
    "test:e2e:pixel-golden": "docker run --rm --platform linux/amd64 -e CI -v \"$(pwd)\":/work -w /work/e2e $(node -p \"'mcr.microsoft.com/playwright:v'+require('@playwright/test/package.json').version+'-noble'\") npx playwright test --config=pixel-golden.config.ts",
    "typecheck": "tsc --build && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.0",
    "serve": "14.2.6",
    "typescript": "catalog:"
  }
}
