# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# packages/schema: Ajv standalone-codegen'd validators (PR-A1.5 prerequisite,
# scripts/generate-ajv-validators.mjs) — regenerated by every `pnpm run
# build` from the current schema, so there is nothing to track; only the
# hand-written *.d.ts stubs in the same directory are source.
packages/schema/src/generated/*.js

# Test artifacts
test-results/
playwright-report/
coverage/

# M0 spike scratch code (throwaway, not product code — ROADMAP M0).
# Written reports (docs/spikes/*.md) are NOT covered by this and stay tracked.
spikes/*
!spikes/README.md

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.mcp.json

# Claude Code personal
CLAUDE.local.md

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
