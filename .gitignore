# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# packages/schema: Ajv standalone-codegen'd validators (PR-A1.5 prerequisite,
# scripts/generate-ajv-validators.mjs) — regenerated by every `pnpm run
# build` from the current schema, so there is nothing to track; only the
# hand-written *.d.ts stubs in the same directory are source.
packages/schema/src/generated/*.js

# @hyakkei/export: generated shared renderer bundle (the .d.ts contract is tracked)
packages/export/src/generated/renderer-code.ts

# Test artifacts
test-results/
playwright-report/
coverage/

# M0 spike scratch code (throwaway, not product code — ROADMAP M0).
# Written reports (docs/spikes/*.md) are NOT covered by this and stay tracked.
spikes/*
!spikes/README.md

# PR-A2 exception: spikes/excel-fidelity/fixtures/ stopped being spike-only
# scratch the moment packages/core/src/datasource/*.test.ts and
# e2e/datasource-register.spec.ts started reading these exact files by
# name — a fresh clone needs them present, not regenerated (xlsx output is
# byte-nondeterministic across ExcelJS runs, so these are tracked as opaque
# goldens; generate-fixtures.mjs stays alongside for provenance/regeneration
# if a fixture ever needs replacing, not for CI to re-run and byte-compare).
!spikes/excel-fidelity/
spikes/excel-fidelity/*
!spikes/excel-fidelity/fixtures/
!spikes/excel-fidelity/generate-fixtures.mjs

# DuckDB-WASM worker/wasm binaries (PR-A1.5, packages/app/scripts/
# copy-duckdb-vendor.mjs), same reasoning as spikes/vendor/ above: these are
# ~75MB, byte-for-byte reproducible from the already-pinned
# @duckdb/duckdb-wasm npm dependency (packages/app/package.json), so
# committing them would only bloat every clone/fetch for no integrity
# benefit — the pinned dependency version IS the provenance record. Copied
# into packages/app/public/vendor/ by `pnpm run build`/`pnpm run dev`
# (predev/prebuild), then Vite copies public/ into dist/ like any other
# static asset.
packages/app/public/vendor/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.mcp.json

# Claude Code personal
CLAUDE.local.md
.claude/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
