{
  "version": 1,
  "meta": {
    "title": "都道府県別経済基盤（e-Stat）",
    "locale": "ja",
    "description": "e-Statの経済基盤表から、都道府県の産業構成・耕地面積・土地生産性を比較するダッシュボード。",
    "updatedAt": "2026-02-20",
    "sourceNote": "e-Stat 表番号0000010203（Ｃ 経済基盤）、budget.csv の画面表示値。割合は％、土地生産性は万円。",
    "summary": "全国の第二次産業事業所構成比は22.69%、第三次産業は76.89%。都道府県別では宮城県の第二次産業構成比が17.96%、北海道が13.44%です。"
  },
  "theme": { "tokens": "@digital-go-jp/design-tokens@2.0.1", "palette": "guidebook-orange" },
  "sources": [
    {
      "id": "economic",
      "kind": "file",
      "format": "csv",
      "ref": {
        "name": "budget.csv",
        "encoding": "UTF-8",
        "url": "https://www.e-stat.go.jp/dbview?sid=0000010203",
        "tableId": "0000010203",
        "surveyYear": "画面表示値"
      }
    }
  ],
  "queries": [
    {
      "id": "q-rate",
      "source": "economic",
      "sql": "SELECT prefecture AS month, secondaryIndustryShare AS rate FROM economic ORDER BY prefecture"
    },
    {
      "id": "q-breakdown",
      "source": "economic",
      "sql": "SELECT indicator AS item, value AS amount FROM economic WHERE prefecture = '全国'"
    },
    {
      "id": "q-detail",
      "source": "economic",
      "sql": "SELECT prefecture AS item, secondaryIndustryShare AS budget, tertiaryIndustryShare AS actual FROM economic"
    }
  ],
  "charts": [
    {
      "id": "budget-rate",
      "type": "area",
      "encoding": { "x": "month", "y": "rate" },
      "query": "q-rate",
      "altText": "都道府県別の第2次産業事業所構成比を比較します。",
      "options": { "title": "第2次産業事業所構成比（％）" }
    },
    {
      "id": "budget-breakdown",
      "type": "pie",
      "encoding": { "category": "item", "value": "amount" },
      "query": "q-breakdown",
      "altText": "全国の経済基盤指標を比較します。",
      "options": { "title": "全国の経済基盤指標", "legend": { "show": true, "position": "right" } }
    },
    {
      "id": "budget-detail",
      "type": "table",
      "encoding": { "columns": ["item", "budget", "actual"] },
      "query": "q-detail",
      "altText": "都道府県ごとの第2次産業と第3次産業の構成比を表で示します。",
      "options": { "title": "都道府県別産業構成" }
    }
  ],
  "layout": {
    "grid": "guidebook-12col",
    "items": [
      { "chart": "budget-rate", "x": 0, "y": 0, "w": 6, "h": 4 },
      { "chart": "budget-breakdown", "x": 6, "y": 0, "w": 6, "h": 4 },
      { "chart": "budget-detail", "x": 0, "y": 4, "w": 12, "h": 3 }
    ]
  }
}
