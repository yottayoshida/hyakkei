{
  "cleanUrls": false,
  "headers": [
    {
      "source": "**/*.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; worker-src 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
